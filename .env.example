# ---------------------------------------------------------------------------
# FitPulse configuration
# Copy to `.env` and adjust. NEVER commit a real `.env` file.
# All values below are optional — the code falls back to documented defaults.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
FITPULSE_ENV=local
FITPULSE_LOG_LEVEL=INFO
# Analysis "as of" date (YYYY-MM-DD). Defaults to the latest Last_Visit_Date
# observed in the membership source so recency is reproducible.
FITPULSE_AS_OF_DATE=

# --- Reproducibility -------------------------------------------------------
# Seed for the documented synthetic integration layer (see LIMITATIONS.md).
FITPULSE_RANDOM_SEED=42

# --- Engagement score weights (must sum to 1.0) ----------------------------
# Product-design assumptions, NOT empirically validated causal weights.
FITPULSE_W_FREQUENCY=0.30
FITPULSE_W_CONSISTENCY=0.25
FITPULSE_W_STREAK=0.20
FITPULSE_W_RECENCY=0.15
FITPULSE_W_DURATION=0.10

# --- Segment thresholds (engagement score 0-100) ---------------------------
FITPULSE_SEG_HIGHLY_ENGAGED=70
FITPULSE_SEG_REGULAR=45
FITPULSE_SEG_AT_RISK=25

# --- Alert thresholds ------------------------------------------------------
FITPULSE_ALERT_INACTIVITY_DAYS=14
FITPULSE_ALERT_ENGAGEMENT_DROP_PCT=50
FITPULSE_ALERT_CHURN_RATE_PCT=30
FITPULSE_ALERT_MISSING_DATA_PCT=10
FITPULSE_ALERT_ACTIVITY_DROP_PCT=25

# --- Database --------------------------------------------------------------
# SQLite by default. Set FITPULSE_DB_URL to a PostgreSQL DSN in a future phase.
FITPULSE_DB_URL=

# --- Email report delivery (optional) --------------------------------------
FITPULSE_SMTP_HOST=
FITPULSE_SMTP_PORT=587
FITPULSE_SMTP_USER=
FITPULSE_SMTP_PASSWORD=
FITPULSE_REPORT_FROM=
FITPULSE_REPORT_TO=
